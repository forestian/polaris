# PyInstaller 빌드 임시 파일
build/
build_tmp/
__pycache__/
*.pyc
*.pyo
*.spec.bak

# 빌드 캐시
*.toc
*.pkg
*.pyz

# 인코딩 깨진 임시 파일 (Windows path collision)
*UserssdfnjDownloads*

# 환경설정 / 민감정보
*.env
.env*
kubeconfig
*.kubeconfig
*.yaml
*.yml
config

# 앱 카탈로그 values 파일은 트래킹 대상 (예외)
!catalog/**/*.yaml
!catalog/**/*.yml

# Claude Code 세션 데이터
.claude/

# kubeconfig 포함 디렉터리
클라우드모니터링/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp

# 압축 파일 (k9s 등 배포 바이너리)
*.tar.gz
*.zip

# 로컬 유틸리티 스크립트 (트래킹 불필요)
scripts/clear_icon_cache.bat

# Python 가상환경
venv/
.venv/
env/

# React UI
ui/node_modules/
ui/.vite/
