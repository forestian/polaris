# PyInstaller 빌드 임시 파일
build/
build_tmp/
__pycache__/
*.pyc
*.pyo
*.spec.bak

# 빌드 캐시
*.toc
*.pkg
*.pyz

# 인코딩 깨진 임시 파일 (Windows path collision)

# 환경설정 / 민감정보
# 앱 안 업데이트 배포 토큰 (v1.3.50) — 빌드 때 실행 파일 안에만 들어간다
packaging/update_token.txt
packaging/update_signing_key.pem
*.env
.env*
kubeconfig
*.kubeconfig
*.yaml
*.yml
config

# 앱 카탈로그 values 파일은 트래킹 대상 (예외)
!catalog/**/*.yaml
!catalog/**/*.yml

# 공개 GitHub 메타 템플릿(ci.yml/dependabot.yml 등)은 트래킹 대상 (예외)
!packaging/github/**/*.yaml
!packaging/github/**/*.yml

# Claude Code 세션 데이터
.claude/

# 문서 · 캡처 · 문서 빌드 스크립트 · 설계 메모 — git 에 올리지 않는다(한 폴더에 모음)
/polaris-docs/
# 루트에 다시 흩어져도 올라가지 않게
/Polaris_*.docx
/Polaris_*.pptx
/Polaris_*.bak-*
/doc-backup-*/
/docs-build/
/polaris 캡쳐/
# 보고서 샘플 · 고객 세션 폴더(고객 데이터 — 절대 올리지 않음) · 설치 파일 빌드 결과
/보고서샘플_*/
/*_Sessions/
/dist/

# kubeconfig 포함 디렉터리
클라우드모니터링/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp

# 압축 파일 (k9s 등 배포 바이너리)
*.tar.gz
*.zip

# onedir 빌드(v1.2.4~): 폴더 제외. zip 은 *.zip(위)으로 무시(설치 exe 임베드용 중간물).
# v1.2.25~: 설치 exe·체크섬도 git 에 커밋하지 않음 — GitLab 패키지 레지스트리에 업로드(최신 1개만 유지).
#          (빌드는 로컬에 생성하고, create_releases.py 가 패키지로 올린다 → repository 비대화 방지)
dist/polaris/
dist/polaris-setup-win64.exe
dist/polaris-setup-win64.exe.sha256
dist/polaris-setup-win64.exe.sha512

# 로컬 유틸리티 스크립트 (트래킹 불필요)
scripts/clear_icon_cache.bat

# Python 가상환경
venv/
.venv/
env/

# React UI
ui/node_modules/
ui/.vite/

# Tauri 설치기 (packaging/setup-tauri) — 소스만 트래킹, 빌드 산출물 제외
packaging/setup-tauri/node_modules/
packaging/setup-tauri/dist/
packaging/setup-tauri/src-tauri/target/
packaging/setup-tauri/src-tauri/payload/

# 원격 데스크톱 ActiveX 셈 — build.py 가 csc.exe 로 만든다(소스만 추적)
packaging/axhost/PolarisAx.dll

# GitHub Actions · dependabot 설정은 추적
!.github/**/*.yml
