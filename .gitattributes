# 체크섬 파일은 절대 줄끝(EOL) 변환하지 않는다.
# CRLF 로 커밋되면 `sha256sum -c polaris.exe.sha256` 가 파일명을 'polaris.exe\r'
# 로 파싱해 검증에 실패한다(실배포 해시검증 사고 방지). 항상 LF 로 유지.
*.sha256 -text
*.sha512 -text

# 바이너리 산출물 — diff/머지/EOL 변환 비활성화
*.exe binary

# Bareos 설치 스크립트는 대상 Linux 서버에서 실행 → 반드시 LF.
# CRLF 면 `#!/usr/bin/env bash\r` 로 깨져 "bad interpreter" + 변수값에 \r 가 붙는다.
src/infra/recipes/assets/*.sh text eol=lf

# 로컬 터미널 내장 Bash(Cygwin) 설정 — bash 가 읽는다 → 반드시 LF (v1.4.19).
# CRLF 면 /etc/profile 의 줄마다 「$'': command not found」.
packaging/localshell/etc/* text eol=lf

# 소스 · 테스트 · 문서는 작업 폴더에서도 LF (v1.5.60).
# 이 PC 는 core.autocrlf=true 라 pull · checkout 때 CRLF 로 바뀌어, 소스를 「\n」 정규식으로
# 읽는 테스트가 코드와 무관하게 깨지는 일이 되풀이됐다. 저장소 안 내용은 원래 전부 LF.
*.py    text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.tpl   text eol=lf
*.spec  text eol=lf
*.rs    text eol=lf
*.cs    text eol=lf
*.conf  text eol=lf
*.sh    text eol=lf
# cmd.exe 가 읽는 배치 파일은 CRLF
*.bat   text eol=crlf
