{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polaris Free Setup",
  "version": "1.5.74-f1",
  "identifier": "io.polaris.free.setup",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Polaris Free 설치",
        "width": 820,
        "height": 612,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
